{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Glob|LS|NotebookRead|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scope_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
